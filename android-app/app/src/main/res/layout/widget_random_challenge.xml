<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_shuffle"
            android:contentDescription="@string/widget_random_challenge_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Random Challenge"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Next Challenge One-Tap Action -->
        <TextView
            android:id="@+id/btn_next_challenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_topic"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Next ↻"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/btn_config_filter"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="2dp"
            android:src="@drawable/ic_target"
            android:contentDescription="Filters" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border"
        android:layout_marginBottom="8dp" />

    <!-- Unauthenticated Banner -->
    <TextView
        android:id="@+id/tv_unauth_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_hard"
        android:padding="6dp"
        android:text="@string/widget_not_logged_in"
        android:textColor="@color/diff_hard"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- Active Filters Badge -->
    <TextView
        android:id="@+id/tv_active_filters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter: All Difficulties • Any Topic"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:layout_marginBottom="6dp" />

    <!-- Problem Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_item"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_challenge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Two Sum"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_challenge_diff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Easy"
                android:textColor="@color/diff_easy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_easy"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/tv_challenge_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Array"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_topic"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/tv_solved_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Solved"
                android:textColor="@color/diff_easy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_open_leetcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary"
                android:gravity="center"
                android:padding="6dp"
                android:text="Open LeetCode"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_mark_solved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_easy"
                android:gravity="center"
                android:padding="6dp"
                android:text="Mark Solved"
                android:textColor="@color/diff_easy"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
