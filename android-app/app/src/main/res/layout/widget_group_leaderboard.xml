<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_trophy"
            android:contentDescription="@string/widget_leaderboard_name" />

        <TextView
            android:id="@+id/tv_group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Leaderboard"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="2dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/widget_btn_refresh"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/btn_config"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="2dp"
            android:src="@drawable/ic_target"
            android:contentDescription="Switch Group" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border"
        android:layout_marginBottom="6dp" />

    <!-- Unauthenticated Banner -->
    <TextView
        android:id="@+id/tv_unauth_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_hard"
        android:padding="6dp"
        android:text="@string/widget_not_logged_in"
        android:textColor="@color/diff_hard"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="4dp" />

    <!-- Rankings List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_rankings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No member data yet"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Footer: Link to Full Leaderboard in CodeSync -->
    <TextView
        android:id="@+id/btn_full_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_secondary"
        android:gravity="center"
        android:padding="6dp"
        android:text="View Full Leaderboard →"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

</LinearLayout>
