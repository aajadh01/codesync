<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Random Challenge Preferences"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Filter which problems are randomly picked for your home screen."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <!-- Difficulty Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target Difficulty"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rg_difficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rb_all_diff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All"
            android:checked="true"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rb_easy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Easy"
            android:textColor="@color/diff_easy"
            android:buttonTint="@color/diff_easy" />

        <RadioButton
            android:id="@+id/rb_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Med"
            android:textColor="@color/diff_medium"
            android:buttonTint="@color/diff_medium" />

        <RadioButton
            android:id="@+id/rb_hard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hard"
            android:textColor="@color/diff_hard"
            android:buttonTint="@color/diff_hard" />
    </RadioGroup>

    <!-- Topic Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Topic Area"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/sp_topics"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_card"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_save_filters"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/btn_primary"
        android:text="Save &amp; Discover Problem"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
