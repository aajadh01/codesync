<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_target"
            android:contentDescription="@string/widget_daily_mission_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Daily DSA Mission"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="2dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/widget_btn_refresh"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/btn_config_target"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="2dp"
            android:src="@drawable/codesync_logo"
            android:contentDescription="Configure Target" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border"
        android:layout_marginBottom="8dp" />

    <!-- Unauthenticated Banner -->
    <TextView
        android:id="@+id/tv_unauth_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_hard"
        android:padding="6dp"
        android:text="@string/widget_not_logged_in"
        android:textColor="@color/diff_hard"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- Progress Target Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_daily_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 / 3 Solved Today"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_daily_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_daily"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progress="0"
        android:max="100"
        android:progressTint="@color/accent_cyan"
        android:progressBackgroundTint="@color/surface_border"
        android:layout_marginBottom="10dp" />

    <!-- Next Mission Task Card -->
    <LinearLayout
        android:id="@+id/layout_next_problem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_item"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next Challenge:"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_next_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared List"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Two Sum"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_next_diff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Easy"
                android:textColor="@color/diff_easy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_easy"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/tv_next_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Array"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_topic"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_solve_leetcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary"
                android:gravity="center"
                android:padding="6dp"
                android:text="Open LeetCode"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_mark_solved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_easy"
                android:gravity="center"
                android:padding="6dp"
                android:text="Mark Solved"
                android:textColor="@color/diff_easy"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
