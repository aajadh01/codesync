<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CodeSync" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Status Bar and Navigation Bar (Colors are applied safely; icons managed via WindowInsetsController) -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Window Background -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.CodeSync.Splash" parent="Theme.CodeSync">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
